# macOS Finder metadata.
.DS_Store

# Ignore top-level working directories except tracked project trees.
/*/
!/docs/
!/configs/
!/notebooks/
!/scripts/
!/src/
!/tests/

# Experiment results are intentionally exposed to Git in full.
!/results/

