# macOS Finder metadata.
.DS_Store

# Ignore every top-level directory except documentation.
/*/
!/docs/
!/configs/
!/notebooks/
!/scripts/
!/src/
!/tests/
!/results/

# Expose only the archived legacy results within the ignored data tree.
!/data/
/data/*
!/data/archive/
/data/archive/*

# /data/
# /.r-lib/
# /.pip-cache/
# /.pytest_cache/
# /.venv/
